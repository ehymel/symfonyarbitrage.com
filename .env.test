# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> cloudflare/turnstile ###
# Cloudflare's published dummy keys -- NOT real credentials.
# .env.local is deliberately not loaded when APP_ENV=test, so the real keys
# never reach the test suite. The dummy sitekey always passes and emits the
# token "XXXX.DUMMY.TOKEN.XXXX"; the dummy secret accepts only that token.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< cloudflare/turnstile ###
