{% apply inky_to_html|inline_css(source('@styles/email.css')) %}
    <container>
        <row class="header">
            <columns>
                <img src="{{ email.image('@images/FDP_icon.png') }}" alt="Symfony Arbitrage">
            </columns>
        </row>
        <row class="content">
            <columns>
                {% block content %}{% endblock %}
            </columns>
        </row>
        <row class="footer">
            <columns>
                &copy; {{ "now"|date("Y") }} Symfony Arbitrage. All rights reserved.
            </columns>
        </row>
    </container>
{% endapply %}
