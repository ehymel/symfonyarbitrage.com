# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
#MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/cache ###
# Backs cache.app, which the scanner and the messenger worker share for circuit breaker
# state and the funding guard's alert throttle. The trailing path is the Redis database
# index, and it is not database 0 on purpose: MESSENGER_TRANSPORT_DSN keeps queued trades
# there, and clearing the cache must not be able to drop them.
REDIS_DSN=redis://localhost:6379/1
###< app/cache ###

###> web-auth/webauthn-symfony-bundle ###
RELYING_PARTY_ID=example.com
RELYING_PARTY_NAME="My Application"
###< web-auth/webauthn-symfony-bundle ###

###> cloudflare/turnstile ###
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
###< cloudflare/turnstile ###

###> symfony/mailtrap-mailer ###
# MAILER_DSN=mailtrap+api://TOKEN@default
# MAILER_DSN=mailtrap+smtp://PASSWORD@default
###< symfony/mailtrap-mailer ###

COINBASE_API_KEY=""
COINBASE_API_SECRET=""

KRAKEN_API_KEY=""
KRAKEN_PRIVATE_KEY=""

GEMINI_API_KEY=""
GEMINI_API_SECRET=""

CRYPTOCOM_API_KEY=""
CRYPTOCOM_API_SECRET=""

###> symfony/amazon-sns-notifier ###
# AMAZON_SNS_DSN=sns://ACCESS_KEY:SECRET_KEY@default?region=REGION
###< symfony/amazon-sns-notifier ###

###> app/admin alerting ###
# Where operational alerts go when the trading pipeline needs a human. Both are used
# together: ADMIN_PHONE_NUMBER carries the headline by SMS, ADMIN_EMAIL the full detail.
# Override in .env.local with real values.
ADMIN_PHONE_NUMBER=
ADMIN_EMAIL=
###< app/admin alerting ###

###> app/trading risk ###
# Headroom each venue must hold beyond what its leg strictly needs, as a fraction of that
# leg. 0 demands an exact cover and nothing more; negative values are rejected at startup.
#
# The buy leg spends quote currency and needs the larger of the two: its cost is derived
# from the price the scanner quoted, and a market order can fill above it, on top of a
# taker fee charged in quote (0.26-0.40% on the venues in ArbitrageEvaluator).
BUY_FUNDING_SAFETY_MARGIN=0.01
# The sell leg delivers an exact quantity of the base asset, so this only absorbs venues
# that take their fee in base and lot-size rounding.
SELL_FUNDING_SAFETY_MARGIN=0.005
###< app/trading risk ###
